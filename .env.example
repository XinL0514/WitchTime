# --- Midscene vision model config ---
# Choose ONE provider below and fill in real values. Do not commit real keys.
# Midscene does not support Anthropic/Claude as the vision-locating model.

# Option A: Gemini
# MIDSCENE_MODEL_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# MIDSCENE_MODEL_API_KEY="your-gemini-api-key"
# MIDSCENE_MODEL_NAME="gemini-3.5-flash"
# MIDSCENE_MODEL_FAMILY="gemini"

# Option B: GPT-5
# MIDSCENE_MODEL_BASE_URL="https://api.openai.com/v1"
# MIDSCENE_MODEL_API_KEY="sk-your-openai-api-key"
# MIDSCENE_MODEL_NAME="gpt-5.5"
# MIDSCENE_MODEL_FAMILY="gpt-5"

# --- Android device / app under test ---
# Serial of the target device or emulator, as shown by `adb devices`.
# Leave unset to auto-pick the first connected device.
ANDROID_DEVICE_ID=

# Package name of the 神笔马良 Android app under test.
MIABI_ANDROID_PACKAGE=com.msb.elemotion

# What agent.launch() should open: a package/activity (com.example/.MainActivity),
# a deep link, or just the app name understood by Midscene's appNameMapping.
# Defaults to MIABI_ANDROID_PACKAGE if unset.
MIABI_ANDROID_LAUNCH_TARGET=

# --- Test account ---
MIABI_TEST_PHONE=MBAICST00005
MIABI_TEST_PASSWORD=443860

# Option B: QWEN
MIDSCENE_MODEL_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
MIDSCENE_MODEL_API_KEY="sk-6375f32347024781836d728fdb244525"
MIDSCENE_MODEL_NAME="qwen3-vl-plus"
MIDSCENE_MODEL_FAMILY="qwen3"

# Additional named accounts (optional): add a _<ROLE> suffix, then request it
# in code with getTestAccount('<role>') from e2e/testdata/accounts.ts. E.g.:
# MIABI_TEST_PHONE_LOGIN=
# MIABI_TEST_PASSWORD_LOGIN=
